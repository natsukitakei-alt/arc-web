{
  "display_information": { "name": "ARC Personal Tasks", "description": "本人の依頼を整理するARC", "background_color": "#08121f" },
  "oauth_config": {
    "redirect_urls": ["https://REPLACE_YOUR_ARC_HOST/auth/slack/callback"],
    "scopes": { "user": ["channels:read", "groups:read", "im:read", "mpim:read", "channels:history", "groups:history", "im:history", "mpim:history"] }
  },
  "settings": {
    "org_deploy_enabled": false, "socket_mode_enabled": false,
    "event_subscriptions": {
      "request_url": "https://REPLACE_YOUR_ARC_HOST/api/slack/events",
      "user_events": ["message.channels", "message.groups", "message.im", "message.mpim"]
    }
  }
}
