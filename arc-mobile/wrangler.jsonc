{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arc-mobile",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ARC_STORE", "class_name": "ArcOwnerStore" }]
  },
  "exports": { "ArcOwnerStore": { "type": "durable-object", "storage": "sqlite" } },
  "observability": { "enabled": false }
}
